<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ServerApplicationMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
	  <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Display name -->
    <ApplicationTitle>ATek Automation</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.ATek.ServerApplicationMobile</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <!-- Firebase Messaging 25 requires Android 6.0/API 23 or newer. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <AndroidSdkDirectory Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('$(LocalAppData)\Android\Sdk')">$(LocalAppData)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\appicon.png" Color="#FFFFFF" ForegroundScale="0.55" />
    <!-- The generated iOS app-icon catalog is not addressable by an Image control. -->
    <MauiImage Include="Resources\appicon.png" Link="Resources\Images\atek_logo.png" />
    <!-- Keep the launch screen aligned with the app's dark theme. Giving the
         splash its own logical name prevents iOS from treating the same source
         as both the app icon and the launch-screen image. -->
    <MauiSplashScreen Include="Resources\appicon.png"
                      Link="Resources\Splash\atek_splash.png"
                      Color="#101318"
                      BaseSize="240,87"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <MauiSplashScreen Include="Resources\appicon.png"
                      Color="#FFFFFF"
                      ForegroundScale="0.6"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json"
                        Condition="Exists('Platforms\Android\google-services.json')" />
    <PackageReference Include="GMapUtils.Android" Version="2.0.0" />
    <!-- 125.1.x moves its AndroidX graph to API 36/minSdk 23, which conflicts
         with MAUI 10.0.20's Maps bindings. This release stays on the matching
         AndroidX generation while still supporting net10.0-android. -->
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.0.1.2" />
    <!-- The current bindings already ship their AARs in lib/. Suppress the
         legacy downloader targets or .NET 10 imports every Google/Firebase AAR
         twice and Android's manifest merger rejects the duplicate namespaces. -->
    <PackageReference Include="Xamarin.Build.Download" Version="0.11.4"
                      ExcludeAssets="build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(Configuration)' == 'Release'">
    <!-- WCF's serialization/callback path includes generic code that cannot always
         be fully discovered by iOS AOT. The concrete proxy avoids Reflection.Emit;
         the interpreter covers the remaining generic instantiations. -->
    <MtouchInterpreter>System.ServiceModel,System.ServiceModel.Primitives,System.ServiceModel.Duplex,System.ServiceModel.NetTcp,System.ServiceModel.NetFramingBase</MtouchInterpreter>
    <CodesignEntitlements>Platforms\iOS\Entitlements.Release.plist</CodesignEntitlements>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(Configuration)' != 'Release'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.Debug.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\ATekCommon\ATekWebCommonDBData\ATekChatCommon.cs"
             Link="Shared\ATekChatCommon.cs" />
    <!-- These two libraries contain portable source only. Link the source into
         the mobile app so Android and iOS restores cannot overwrite a shared
         project.assets.json with incompatible platform target information. -->
    <Compile Include="..\..\..\ATekCommon\CADSEncryptDecryptLib\EncryptDecrypt.cs"
             Link="Shared\EncryptDecrypt.cs" />
    <Compile Include="..\..\..\ATekCommon\SharedEnums\SharedEnum.cs"
             Link="Shared\SharedEnum.cs" />
  </ItemGroup>
  <ItemGroup>
