<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ServerApplicationMobile.Services"
             x:Class="ServerApplicationMobile.ServiceTechsPage"
             Title="Service Techs"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="10">
        <VerticalStackLayout Spacing="2">
            <Label Text="Service tech chats"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <Label Text="Choose a technician to open a separate conversation."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <CollectionView x:Name="ServiceTechsCollection"
                        Grid.Row="1"
                        ItemsSource="{Binding ServiceTechs}"
                        SelectionMode="None"
                        EmptyView="No service tech conversations are available.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ServiceTechSession">
                    <Border Margin="0,4"
                            Padding="12,10"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnServiceTechTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding DisplayName}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1"
                                   Text="{Binding OnlineStatus}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                            <Label Grid.Row="1"
                                   Text="{Binding Details}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding UnreadCount, StringFormat='Unread: {0}'}"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
