<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ServerApplicationMobile.Services"
             x:Class="ServerApplicationMobile.ChatLogsPage"
             Title="Chat Logs"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <Grid Padding="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <SearchBar x:Name="ChatSearchBar"
                   Placeholder="Customer, OEM, job, user, or message"
                   SearchButtonPressed="OnSearchSubmitted"
                   TextChanged="OnSearchTextChanged" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <VerticalStackLayout>
                <Label Text="From" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <DatePicker x:Name="StartDatePicker" DateSelected="OnFilterChanged" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="To" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <DatePicker x:Name="EndDatePicker" DateSelected="OnFilterChanged" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <HorizontalStackLayout Spacing="6">
                <CheckBox x:Name="AllTimeCheckBox" CheckedChanged="OnAllTimeChanged" />
                <Label Text="Show all time" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" Padding="14,6" />
        </Grid>

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="ChatLogsCollection"
                            SelectionMode="None"
                            EmptyView="No chat logs match these filters.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatLog">
                        <Frame Margin="0,4" Padding="12,10" CornerRadius="8"
                               HasShadow="False"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChatLogTapped"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding CustomerName}" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding DisplayDate}" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Details}" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding MessagePreview}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="Tap to view chat log"
                                       FontSize="10" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" HorizontalTextAlignment="End" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" x:Name="ActivityIndicator"
                           IsRunning="False" IsVisible="False"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
