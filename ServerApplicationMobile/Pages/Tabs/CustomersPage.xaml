<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServerApplicationMobile.CustomersPage"
             Title="Customers">

    <Grid RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- SearchBar -->
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- CollectionView -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <SearchBar Placeholder="Search customers"
                       x:Name="CustomerSearchBar"
                       SearchButtonPressed="OnSearchSubmitted"
                       TextChanged="CustomerSearchBar_TextChanged"
                       Focused="OnCustomerSearchFocused"
                       Unfocused="OnCustomerSearchUnfocused"
                       VerticalOptions="Start" />
            <Button x:Name="DismissSearchButton"
                    Grid.Column="1"
                    Text="Done"
                    Margin="0,4,6,4"
                    Padding="12,6"
                    VerticalOptions="Fill"
                    LineBreakMode="NoWrap"
                    IsVisible="False"
                    Clicked="OnDismissSearchClicked" />
        </Grid>

        <!-- Header row -->
        <Grid ColumnDefinitions="*,*" Padding="10"
              BackgroundColor="{AppThemeBinding Light={StaticResource SectionBackgroundLight}, Dark={StaticResource SectionBackgroundDark}}"
              Grid.Row="1">
            <Label Text="Name" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Label Text="OEM" FontAttributes="Bold" FontSize="12" Grid.Column="1" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Grid>

        <!-- Data list -->
        <CollectionView x:Name="CustomerCollectionView"
                        Margin="0"
                        SelectionMode="None"
                        Scrolled="OnCustomerListScrolled"
                        Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Padding="5"
                Margin="5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomerTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,*"
                  Padding="10"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill">
                            <Label Text="{Binding CustomerName}" FontSize="11" Grid.Column="0"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="NoWrap" />
                            <Label Text="{Binding OEM}" FontSize="11" Grid.Column="1"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="NoWrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>



        </CollectionView>
    </Grid>
</ContentPage>
