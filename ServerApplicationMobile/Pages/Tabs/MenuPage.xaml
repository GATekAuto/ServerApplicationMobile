<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServerApplicationMobile.MenuPage"
             Title="Menu">
    <Grid>
        <ScrollView IsEnabled="True" x:Name="MenuView">
            <VerticalStackLayout Padding="20,20,20,32"
                                 Spacing="14"
                                 MaximumWidthRequest="560"
                                 HorizontalOptions="Fill">
                <Label Text="Tools"
                       Margin="4,0,4,4"
                       FontAttributes="Bold"
                       FontSize="22" />

                <Grid HeightRequest="62">
                    <Button HorizontalOptions="Fill"
                            SemanticProperties.Description="Service Tickets"
                            Clicked="OnServiceTicketsClicked" />
                    <Grid Margin="22,0"
                          ColumnDefinitions="28,*"
                          ColumnSpacing="14"
                          InputTransparent="True">
                        <Image Source="jobs.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Service Tickets"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>

                <Grid HeightRequest="62">
                    <Button HorizontalOptions="Fill"
                            SemanticProperties.Description="Software Logs"
                            Clicked="OnSoftwareLogsClicked" />
                    <Grid Margin="22,0"
                          ColumnDefinitions="28,*"
                          ColumnSpacing="14"
                          InputTransparent="True">
                        <Image Source="info.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Software Logs"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>

                <Grid HeightRequest="62">
                    <Button HorizontalOptions="Fill"
                            SemanticProperties.Description="Chat Logs"
                            Clicked="OnChatLogsClicked" />
                    <Grid Margin="22,0"
                          ColumnDefinitions="28,*"
                          ColumnSpacing="14"
                          InputTransparent="True">
                        <Image Source="chat.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Chat Logs"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>

                <Grid HeightRequest="62"
                      Margin="0,0,0,0">
                    <Button HorizontalOptions="Fill"
                            SemanticProperties.Description="Log Out"
                            Clicked="OnLogoutClicked" />
                    <Grid Margin="22,0"
                          ColumnDefinitions="28,*"
                          ColumnSpacing="14"
                          InputTransparent="True">
                        <Image Source="logout.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Log Out"
                               TextColor="White"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator HorizontalOptions="Center"
                           VerticalOptions="Center"
                           x:Name="ActivityIndicator"
                           IsRunning="False" />
    </Grid>
</ContentPage>
