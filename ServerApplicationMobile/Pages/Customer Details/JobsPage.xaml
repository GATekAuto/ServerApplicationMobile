<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServerApplicationMobile.Pages.Customer_Details.JobsPage"
             Title="Jobs Page">
    <Grid>
        <VerticalStackLayout Spacing="5">

            <!--Header-->
            <Grid ColumnDefinitions="*,*,*,*,*" Padding="10"
                  BackgroundColor="{AppThemeBinding Light={StaticResource SectionBackgroundLight}, Dark={StaticResource SectionBackgroundDark}}">
                <Label Text="Job #" Grid.Column="0" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
                <Label Text="Serial #" Grid.Column="1" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
                <Label Text="OEM #" Grid.Column="2" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
                <Label Text="Install Date" Grid.Column="3" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
                <Label Text="Machine" Grid.Column="4" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
            </Grid>

            <!--Jobs List-->
            <CollectionView x:Name="JobsCollectionView"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5" CornerRadius="8" HasShadow="False"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnJobTapped" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="*,*,*,*,*">
                                <Label Text="{Binding JobNumber}" Grid.Column="0" FontSize="11" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                                <Label Text="{Binding SerialNumber}" Grid.Column="1" FontSize="11" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                                <Label Text="{Binding OEMNumber}" Grid.Column="2" FontSize="11" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                                <Label Text="{Binding InstallDate, StringFormat='{0:MM/dd/yyyy}'}" Grid.Column="3" FontSize="11" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                                <Label Text="{Binding MachineType}" Grid.Column="4" FontSize="11" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
