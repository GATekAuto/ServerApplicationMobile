<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="ServerApplicationMobile.CustomerDetailPage"
            Title="Customer Details">
    <ScrollView>

        <Grid RowDefinitions="auto,auto,auto,auto">

            <Button Text="Jobs                 " Clicked="OnJobClicked" LineBreakMode="WordWrap" FontSize="13" ImageSource="jobs.png" ContentLayout="left, 9"  HeightRequest="50" Grid.Row="0" Margin="5" />
            <Button Text="Products        " Clicked="OnProductClicked" LineBreakMode="WordWrap" FontSize="13" ImageSource="products.png"  HeightRequest="50" Grid.Row="1" Margin="5"/>
            <Button Text="Customer Info" Clicked="OnCustomerInfoClicked" FontSize="13" ImageSource="info.png" ContentLayout="left, 5"  HeightRequest="50" Grid.Row="2" Margin="5"/>
            <Button Text="Get Directions" Clicked="OnGetDirectionsClicked"  LineBreakMode="WordWrap" FontSize="13" ImageSource="map.png" ContentLayout="left, 5"  HeightRequest="50" Grid.Row="3" Margin="5"/>

        </Grid>
    </ScrollView>
</ContentPage>