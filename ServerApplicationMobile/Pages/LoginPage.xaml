<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServerApplicationMobile.LoginPage"
             Title="Sign in">

    <ScrollView>
        <Grid Padding="40" MinimumWidthRequest="300">
            <VerticalStackLayout VerticalOptions="Center" Spacing="16" MaximumWidthRequest="480">
                <Image Source="atek_logo.png"
                       HorizontalOptions="Center"
                       HeightRequest="88"
                       Aspect="AspectFit" />

                <Label Text="Login"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="Email" FontSize="16" />
                <Entry x:Name="entrUsername"
                       Placeholder="Email"
                       ReturnType="Next"
                       TextChanged="OnCredentialsChanged" />

                <Label Text="Password" FontSize="16" />
                <Entry x:Name="entrPassword"
                       IsPassword="True"
                       Placeholder="Password"
                       ReturnType="Go"
                       TextChanged="OnCredentialsChanged"
                       Completed="OnPasswordCompleted" />

                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="RememberSignInCheckBox"
                              VerticalOptions="Center" />
                    <Label Text="Keep me signed in"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label x:Name="ErrorLabel"
                       TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                       IsVisible="False"
                       LineBreakMode="WordWrap" />

                <Button Text="Sign in"
                        Clicked="OnLoginClicked"
                        x:Name="btnLogin"
                        IsEnabled="False" />
                <ActivityIndicator x:Name="ActivityIndicator"
                                   IsRunning="False"
                                   IsVisible="False" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
